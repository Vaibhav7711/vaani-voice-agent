# Optional external speech-inference WebSocket implementing the protocol in docs/realtime-protocol.md.
VOICE_INFERENCE_WS_URL=
VOICE_INFERENCE_API_KEY=
VOICE_INFERENCE_OUTPUT_AUDIO=false
VOICE_INFERENCE_PROVIDER_NAME=external-websocket

# Durable sessions and distributed turn locking. Leave blank for the in-memory local backend.
# Compose URL: postgresql://vaani:vaani_local_only@127.0.0.1:5432/vaani
DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_SSL=false
REDIS_URL=
# Generate with: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=

# Optional OpenAI-compatible planner endpoint (vLLM, SGLang, or another compatible server).
# The planner classifies intent only; it cannot call lender tools or write customer-facing responses.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=1800

# Custom server settings.
HOST=127.0.0.1
PORT=3000
